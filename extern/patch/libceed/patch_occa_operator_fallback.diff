diff --git a/backends/occa/ceed-occa.cpp b/backends/occa/ceed-occa.cpp
index eca2f4e7..a5d0bdd2 100644
--- a/backends/occa/ceed-occa.cpp
+++ b/backends/occa/ceed-occa.cpp
@@ -254,6 +254,27 @@ static int initCeed(const char *c_resource, Ceed ceed) {
   ceed::occa::Context *context = new Context(::occa::device(deviceProps));
   CeedCallBackend(CeedSetData(ceed, context));
 
+  // This backend does not implement CeedOperatorLinearAssembleQFunction (and
+  // the diagonal-/full-assembly routines built on it), so register a
+  // reference-backend fallback Ceed for those operations -- the same pattern
+  // backends/cuda-gen and backends/hip-gen use for their own unimplemented
+  // operations. See ceed-occa-operator.cpp: the LinearAssemble* backend
+  // function pointers are deliberately left unregistered so the generic
+  // interface dispatcher in interface/ceed-preconditioning.c falls through
+  // to this fallback instead of a hard "not implemented" error.
+  {
+    std::string fallbackResource = "/cpu/self/ref/serial";
+    if (mode == "CUDA") {
+      fallbackResource = "/gpu/cuda/ref";
+    } else if (mode == "HIP") {
+      fallbackResource = "/gpu/hip/ref";
+    }
+    Ceed ceedFallback;
+    CeedCallBackend(CeedInit(fallbackResource.c_str(), &ceedFallback));
+    CeedCallBackend(CeedSetOperatorFallbackCeed(ceed, ceedFallback));
+    CeedCallBackend(CeedDestroy(&ceedFallback));
+  }
+
   return CEED_ERROR_SUCCESS;
 }
 
