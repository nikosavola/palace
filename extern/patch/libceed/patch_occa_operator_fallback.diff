+// CEED_RESTRICTION_ORIENTED support. There is no native OCCA kernel for
+// oriented restrictions (see applyGeneric() and ceedApply() below for why the
+// host-array-based path is used for these unconditionally); this only needs
+// to produce a host-readable bool array, regardless of the memType the
+// caller passed the orients in with.
+void ElemRestriction::setupOrients(CeedMemType memType, CeedCopyMode copyMode, const bool *orientsInput) {
+  isOriented             = true;
+  const CeedInt entries  = ceedElementCount * ceedElementSize;
+
+  if (memType == CEED_MEM_HOST) {
+    freeHostOrients = (copyMode == CEED_OWN_POINTER || copyMode == CEED_COPY_VALUES);
+    if (copyMode != CEED_COPY_VALUES) {
+      hostOrients = const_cast<bool *>(orientsInput);
+    } else {
+      const size_t bytes = entries * sizeof(bool);
+      hostOrients         = (bool *)::malloc(bytes);
+      std::memcpy(hostOrients, orientsInput, bytes);
+    }
+  } else {
+    // Device memory: always make our own host copy since orients are only
+    // ever consulted from the host-array-based apply path.
+    ::occa::memory deviceOrients = arrayToMemory(orientsInput);
+    freeHostOrients               = true;
+    hostOrients                   = (bool *)::malloc(entries * sizeof(bool));
+    deviceOrients.copyTo(hostOrients);
+    if (copyMode == CEED_OWN_POINTER) {
+      deviceOrients.free();
+    }
+  }
+}
