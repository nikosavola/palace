+int ElemRestriction::applyGeneric(CeedTransposeMode rTransposeMode, CeedVector u, CeedVector v) {
+  const bool rIsTransposed = (rTransposeMode != CEED_NOTRANSPOSE);
+  const bool usesIdx       = usesIndices();
+
+  // hostIndices is only populated when the restriction was created with
+  // CEED_MEM_HOST (the common case); fall back to reading device memory
+  // back to the host otherwise.
+  CeedInt *hostIdx    = hostIndices;
+  CeedInt *ownedHostIdx = NULL;
+  if (usesIdx && !hostIdx) {
+    const CeedInt entries = ceedElementCount * ceedElementSize;
+    ownedHostIdx          = (CeedInt *)::malloc(entries * sizeof(CeedInt));
+    indices.copyTo(ownedHostIdx);
+    hostIdx = ownedHostIdx;
+  }
+
+  if (!rIsTransposed) {
+    const CeedScalar *uArray;
+    CeedScalar       *vArray;
+    CeedCallBackend(CeedVectorGetArrayRead(u, CEED_MEM_HOST, &uArray));
+    CeedCallBackend(CeedVectorGetArrayWrite(v, CEED_MEM_HOST, &vArray));
+    for (CeedInt e = 0; e < ceedElementCount; ++e) {
+      for (CeedInt node = 0; node < ceedElementSize; ++node) {
+        const CeedInt vBase = node + e * ceedElementSize * ceedComponentCount;
+        if (usesIdx) {
+          const CeedInt   index = hostIdx[node + e * ceedElementSize];
+          const CeedScalar sign  = (isOriented && hostOrients[node + e * ceedElementSize]) ? -1.0 : 1.0;
+          for (CeedInt c = 0; c < ceedComponentCount; ++c) {
+            vArray[vBase + c * ceedElementSize] = sign * uArray[index + c * ceedUnstridedComponentStride];
+          }
+        } else {
+          for (CeedInt c = 0; c < ceedComponentCount; ++c) {
+            vArray[vBase + c * ceedElementSize] =
+                uArray[node * ceedNodeStride + c * ceedComponentStride + e * ceedElementStride];
+          }
+        }
+      }
+    }
+    CeedCallBackend(CeedVectorRestoreArrayRead(u, &uArray));
+    CeedCallBackend(CeedVectorRestoreArray(v, &vArray));
+  } else {
+    const CeedScalar *uArray;
+    CeedScalar       *vArray;
+    CeedCallBackend(CeedVectorGetArrayRead(u, CEED_MEM_HOST, &uArray));
+    CeedCallBackend(CeedVectorGetArray(v, CEED_MEM_HOST, &vArray));
+    for (CeedInt e = 0; e < ceedElementCount; ++e) {
+      for (CeedInt node = 0; node < ceedElementSize; ++node) {
+        const CeedInt uBase = node + e * ceedElementSize * ceedComponentCount;
+        if (usesIdx) {
+          const CeedInt   index = hostIdx[node + e * ceedElementSize];
+          const CeedScalar sign  = (isOriented && hostOrients[node + e * ceedElementSize]) ? -1.0 : 1.0;
+          for (CeedInt c = 0; c < ceedComponentCount; ++c) {
+            vArray[index + c * ceedUnstridedComponentStride] += sign * uArray[uBase + c * ceedElementSize];
+          }
+        } else {
+          for (CeedInt c = 0; c < ceedComponentCount; ++c) {
+            vArray[node * ceedNodeStride + c * ceedComponentStride + e * ceedElementStride] += uArray[uBase + c * ceedElementSize];
+          }
+        }
+      }
+    }
+    CeedCallBackend(CeedVectorRestoreArrayRead(u, &uArray));
+    CeedCallBackend(CeedVectorRestoreArray(v, &vArray));
+  }
+
+  if (ownedHostIdx) {
+    ::free(ownedHostIdx);
+  }
+  return CEED_ERROR_SUCCESS;
+}
