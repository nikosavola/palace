+// CEED_RESTRICTION_CURL_ORIENTED support. Same host-only rationale as
+// setupOrients() above: applyCurlOriented() is the only consumer.
+void ElemRestriction::setupCurlOrients(CeedMemType memType, CeedCopyMode copyMode, const CeedInt8 *curlOrientsInput) {
+  isCurlOriented        = true;
+  const CeedInt entries = ceedElementCount * ceedElementSize * 3;
+
+  if (memType == CEED_MEM_HOST) {
+    freeHostCurlOrients = (copyMode == CEED_OWN_POINTER || copyMode == CEED_COPY_VALUES);
+    if (copyMode != CEED_COPY_VALUES) {
+      hostCurlOrients = const_cast<CeedInt8 *>(curlOrientsInput);
+    } else {
+      const size_t bytes = entries * sizeof(CeedInt8);
+      hostCurlOrients      = (CeedInt8 *)::malloc(bytes);
+      std::memcpy(hostCurlOrients, curlOrientsInput, bytes);
+    }
+  } else {
+    ::occa::memory deviceCurlOrients = arrayToMemory(curlOrientsInput);
+    freeHostCurlOrients               = true;
+    hostCurlOrients                   = (CeedInt8 *)::malloc(entries * sizeof(CeedInt8));
+    deviceCurlOrients.copyTo(hostCurlOrients);
+    if (copyMode == CEED_OWN_POINTER) {
+      deviceCurlOrients.free();
+    }
+  }
+}
