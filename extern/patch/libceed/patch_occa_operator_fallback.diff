+// libCEED's operator-fallback mechanism (CeedOperatorGetFallback /
+// CeedOperatorCreateFallback, interface/ceed-preconditioning.c) reuses the
+// *original* CeedElemRestriction/CeedBasis objects directly on a fallback
+// CeedOperator that lives on a different (reference) Ceed, while any
+// CeedVectors the generic fallback algorithms create (e.g.
+// CeedOperatorAssembleSymbolicSingle's index_vec_in/elem_dof_in) are created
+// on that fallback Ceed. When CeedElemRestrictionApply is then called with
+// this (OCCA-backed) restriction against one of those foreign vectors,
+// Vector::from() below would reinterpret the foreign vector's own
+// backend-private data as a ceed::occa::Vector*, which is undefined
+// behavior (observed in practice as a segfault deep inside OCCA's memory
+// bookkeeping). Detect this and route through a plain host-array
+// implementation instead, which works correctly regardless of which Ceed
+// created u/v since it only uses the generic CeedVector array API.
+static bool ceedVectorIsForeign(CeedVector vec, Ceed expectedCeed) {
+  if (!vec || vec == CEED_VECTOR_NONE) {
+    return false;
+  }
+  Ceed vecCeed;
+  if (CeedVectorGetCeed(vec, &vecCeed)) {
+    // Could not determine the vector's Ceed -- be conservative and treat it
+    // as foreign so the safe, generic path is used.
+    return true;
+  }
+  const bool foreign = (vecCeed != expectedCeed);
+  CeedDestroy(&vecCeed);
+  return foreign;
+}
