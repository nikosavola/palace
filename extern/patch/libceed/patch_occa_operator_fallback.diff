+// Ported directly from backends/ref/ceed-ref-restriction.c's
+// CeedElemRestrictionApply{,Curl}OrientedNoTranspose/Transpose_Ref_Core,
+// specialized to block_size == 1 and v_offset == 0 (ceed-occa does not
+// implement blocked restrictions -- see ceedApplyBlock() below). Storage
+// layout for hostCurlOrients matches libCEED's own convention exactly (also
+// matches how Palace itself writes tp_el_curl_orients in
+// palace/fem/libceed/restriction.cpp): 3 coefficients per (node, element),
+// laid out as curlOrients[(3*node + c) + element*3*elementSize] for
+// c in {0,1,2} representing that node's tridiagonal row (contributions from
+// the previous node, itself, and the next node, respectively -- with the
+// first/last node in an element having only 2 of the 3 terms).
+//
+// The no-transpose and transpose cores are intentionally NOT derived from
+// each other here: transposing a tridiagonal matrix shifts which neighbor's
+// coefficient index applies (a column-read instead of a row-read), so each
+// is ported separately from its own reference core to avoid introducing a
+// transpose-specific indexing bug that a naive derivation could hide.
+int ElemRestriction::applyCurlOriented(CeedTransposeMode rTransposeMode, CeedVector u, CeedVector v) {
+  const bool rIsTransposed = (rTransposeMode != CEED_NOTRANSPOSE);
+
+  // Curl-oriented restrictions always use offsets (never strided).
+  CeedInt *hostIdx     = hostIndices;
+  CeedInt *ownedHostIdx = NULL;
+  if (!hostIdx) {
+    const CeedInt entries = ceedElementCount * ceedElementSize;
+    ownedHostIdx          = (CeedInt *)::malloc(entries * sizeof(CeedInt));
+    indices.copyTo(ownedHostIdx);
+    hostIdx = ownedHostIdx;
+  }
+
+  const CeedInt elemSize = ceedElementSize;
+  auto           offsetAt = [&](CeedInt node, CeedInt e) { return hostIdx[node + e * elemSize]; };
+  // Raw tridiagonal-storage index (matches the "3*n + c" expressions in the
+  // reference backend directly, including transpose's out-of-[0,2] column
+  // indices like "3*n - 1" / "3*n + 3", which land in the neighbor node's
+  // own 3 coefficients).
+  auto curlRaw = [&](CeedInt rawIndex, CeedInt e) { return (CeedScalar)hostCurlOrients[rawIndex + e * 3 * elemSize]; };
+
+  if (!rIsTransposed) {
+    const CeedScalar *uArray;
+    CeedScalar       *vArray;
+    CeedCallBackend(CeedVectorGetArrayRead(u, CEED_MEM_HOST, &uArray));
+    CeedCallBackend(CeedVectorGetArrayWrite(v, CEED_MEM_HOST, &vArray));
+    for (CeedInt e = 0; e < ceedElementCount; ++e) {
+      for (CeedInt k = 0; k < ceedComponentCount; ++k) {
+        for (CeedInt n = 0; n < elemSize; ++n) {
+          CeedScalar val = uArray[offsetAt(n, e) + k * ceedUnstridedComponentStride] * curlRaw(3 * n + 1, e);
+          if (n > 0) {
+            val += uArray[offsetAt(n - 1, e) + k * ceedUnstridedComponentStride] * curlRaw(3 * n + 0, e);
+          }
+          if (n < elemSize - 1) {
+            val += uArray[offsetAt(n + 1, e) + k * ceedUnstridedComponentStride] * curlRaw(3 * n + 2, e);
+          }
+          vArray[n + k * elemSize + e * elemSize * ceedComponentCount] = val;
+        }
+      }
+    }
+    CeedCallBackend(CeedVectorRestoreArrayRead(u, &uArray));
+    CeedCallBackend(CeedVectorRestoreArray(v, &vArray));
+  } else {
+    const CeedScalar *uArray;
+    CeedScalar       *vArray;
+    CeedCallBackend(CeedVectorGetArrayRead(u, CEED_MEM_HOST, &uArray));
+    CeedCallBackend(CeedVectorGetArray(v, CEED_MEM_HOST, &vArray));
+    for (CeedInt e = 0; e < ceedElementCount; ++e) {
+      for (CeedInt k = 0; k < ceedComponentCount; ++k) {
+        for (CeedInt n = 0; n < elemSize; ++n) {
+          const CeedInt uBase = k * elemSize + e * elemSize * ceedComponentCount;
+          CeedScalar    val   = uArray[n + uBase] * curlRaw(3 * n + 1, e);
+          if (n > 0) {
+            val += uArray[(n - 1) + uBase] * curlRaw(3 * n - 1, e);
+          }
+          if (n < elemSize - 1) {
+            val += uArray[(n + 1) + uBase] * curlRaw(3 * n + 3, e);
+          }
+          vArray[offsetAt(n, e) + k * ceedUnstridedComponentStride] += val;
+        }
+      }
+    }
+    CeedCallBackend(CeedVectorRestoreArrayRead(u, &uArray));
+    CeedCallBackend(CeedVectorRestoreArray(v, &vArray));
+  }
+
+  if (ownedHostIdx) {
+    ::free(ownedHostIdx);
+  }
+  return CEED_ERROR_SUCCESS;
+}
